# Agency workspace: one sub-folder per client project (default: ./projects, relative to this repo).
# Each project has its own business.yaml, project.env (Meta ad account), data and reports.
PROJECTS_DIR=./projects

# --- Meta Marketing API (optional; folder import works without it) ---
# Agency-wide defaults. A project's own projects/<project>/project.env overrides them.
META_ACCESS_TOKEN=            # system-user token: ads_read (+ ads_management only if Claude may change ads after your confirmation)
# Managing ads is switched on per client in projects/<client>/project.env (META_WRITE_ENABLED, META_PAGE_ID, ...)
# META_AD_ACCOUNT_ID is NOT read from here: set it per project (configure_project_meta or project.env)
META_API_VERSION=v21.0        # keep configurable; check Meta's current version

# --- Meta Ad Library API (optional) ---
META_AD_LIBRARY_TOKEN=        # can be same token if app has Ad Library access

# --- Web fetching ---
WEB_USER_AGENT=AIMarketingManagerBot/1.0 (+https://github.com/afnan-mahmud/ai-marketing-manager)
WEB_TIMEOUT_MS=15000

# debug | info | warn | error (logs go to stderr)
LOG_LEVEL=info
